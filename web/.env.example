# web/.env.example: daftar environment variable aplikasi (TANPA nilai rahasia).
# Di compose nilainya diisi docker-compose.yml, di Render lewat tab
# Environment, di Kubernetes lewat Secret/env. Berkas .env TIDAK di-commit.

# --- identitas
APP_NAME=TB
APP_PEMILIK="Kelompok 0 - Starter Laravel"   # tampil di halaman (pengganti const PEMILIK)
APP_ENV=production
APP_DEBUG=false                              # true hanya di laptop, JANGAN di Render
APP_URL=http://localhost:8080
PAKSA_APP_URL=0                              # 1 = semua URL dibuat dari APP_URL
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
# APP_KEY wajib di produksi. Buat:
#   docker run --rm --entrypoint php IMAGE artisan key:generate --show
APP_KEY=

# --- database: satu URL (kontrak kuliah). Neon: URL pooled + sslmode=require
# Neon: salin "Connection string" (Pooled) dari dasbor Neon, akhiri ?sslmode=require
DATABASE_URL=postgresql://app:latihan@db:5432/app
DB_TIMEOUT=3                                 # detik, batas waktu koneksi (P15)
MIGRASI_SAAT_START=1                         # php artisan migrate --force saat start

# --- sesi, cache, antrean: bawaan di PostgreSQL yang sama (cukup satu database)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database                    # sqs = antrean SQS (P14, Floci)
JALANKAN_WORKER=0                            # 1 = worker + scheduler di container web (Render Free)
JADWAL_REKAP="55 23 * * *"                   # cron rekap:harian

# --- object storage S3-compatible (Floci di lab, Supabase Storage di produksi)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tb-berkas
AWS_ENDPOINT=http://floci:4566
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- antrean SQS (hanya bila QUEUE_CONNECTION=sqs)
SQS_PREFIX=http://floci:4566/000000000000
SQS_QUEUE=antrean-tb

# --- log ke stderr (dibaca docker logs, Render, Loki)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- surat (lupa password): bawaan ditulis ke log, tidak benar-benar dikirim
MAIL_MAILER=log
MAIL_FROM_ADDRESS="tb@example.com"
MAIL_FROM_NAME="${APP_NAME}"
